<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PropertyLease</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- 🔑 ANTI-FORGERY TOKEN — REQUIRED FOR AJAX LOGIN/REGISTER -->
    @Html.AntiForgeryToken()

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo">
                <a href="@Url.Action("Index", "Home")"><i class="fas fa-building"></i> Property<span>Leasing</span></a>
            </div>
            <div class="nav-links" style="display:flex; align-items:center; flex-wrap:wrap; gap:20px;">
                <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Properties</a>
                <a href="#"><i class="fas fa-city"></i> Cities</a>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- ===== LOGIN MODAL ===== -->
    <div id="loginModal" class="auth-modal-overlay" style="display:none;">
        <div class="auth-modal">
            <button type="button" class="auth-modal-close" onclick="closeLoginModal()">
                <i class="fas fa-times"></i>
            </button>

            <h2 style="margin-bottom:6px; color:#0b2a3c;">
                <i class="fas fa-user-circle" style="color:#1e7b85;"></i> Welcome Back
            </h2>
            <p style="color:#4d6a7a; margin-bottom:22px; font-size:0.95rem;">Sign in to your account</p>

            <div id="loginError" style="display:none; padding:12px; background:#f8d7da; color:#721c24; border-radius:8px; margin-bottom:15px; font-size:0.9rem;"></div>

            <form id="loginForm" onsubmit="submitLogin(event)">
                <label style="display:block; font-weight:500; margin-bottom:6px;">Email</label>
                <input type="email" id="loginEmail" required
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; margin-bottom:16px; font-size:1rem;" />

                <label style="display:block; font-weight:500; margin-bottom:6px;">Password</label>
                <div style="position:relative; margin-bottom:20px;">
                    <input type="password" id="loginPassword" required
                           style="width:100%; padding:12px 45px 12px 12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;" />
                    <button type="button" class="password-toggle" onclick="togglePassword('loginPassword', this)" tabindex="-1">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>

                <button type="submit" id="loginSubmitBtn"
                        style="width:100%; padding:14px; background:#1e7b85; color:white; border:none; border-radius:8px; font-weight:600; font-size:1rem; cursor:pointer;">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </button>
            </form>

            <p style="text-align:center; margin-top:18px; color:#4d6a7a; font-size:0.9rem;">
                Don't have an account?
                <a href="javascript:void(0)" onclick="switchToRegister()" style="color:#1e7b85; font-weight:600; text-decoration:none;">
                    Register here
                </a>
            </p>
        </div>
    </div>

    <!-- ===== REGISTER MODAL ===== -->
    <div id="registerModal" class="auth-modal-overlay" style="display:none;">
        <div class="auth-modal">
            <button type="button" class="auth-modal-close" onclick="closeRegisterModal()">
                <i class="fas fa-times"></i>
            </button>

            <h2 style="margin-bottom:6px; color:#0b2a3c;">
                <i class="fas fa-user-plus" style="color:#1e7b85;"></i> Create Account
            </h2>
            <p style="color:#4d6a7a; margin-bottom:22px; font-size:0.95rem;">Register to get started</p>

            <div id="registerError" style="display:none; padding:12px; background:#f8d7da; color:#721c24; border-radius:8px; margin-bottom:15px; font-size:0.9rem;"></div>
            <div id="registerSuccess" style="display:none; padding:12px; background:#d4edda; color:#155724; border-radius:8px; margin-bottom:15px; font-size:0.9rem;"></div>

            <form id="registerForm" onsubmit="submitRegister(event)">
                <label style="display:block; font-weight:500; margin-bottom:6px;">Full Name</label>
                <input type="text" id="registerFullName" required
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; margin-bottom:16px; font-size:1rem;" />

                <label style="display:block; font-weight:500; margin-bottom:6px;">Email</label>
                <input type="email" id="registerEmail" required
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; margin-bottom:16px; font-size:1rem;" />

                <label style="display:block; font-weight:500; margin-bottom:6px;">Password</label>
                <div style="position:relative; margin-bottom:6px;">
                    <input type="password" id="registerPassword" required minlength="6"
                           style="width:100%; padding:12px 45px 12px 12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;" />
                    <button type="button" class="password-toggle" onclick="togglePassword('registerPassword', this)" tabindex="-1">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <small style="color:#4d6a7a; font-size:0.8rem; display:block; margin-bottom:16px;">
                    At least 6 characters with a number.
                </small>

                <button type="submit" id="registerSubmitBtn"
                        style="width:100%; padding:14px; background:#1e7b85; color:white; border:none; border-radius:8px; font-weight:600; font-size:1rem; cursor:pointer;">
                    <i class="fas fa-user-plus"></i> Register
                </button>
            </form>

            <p style="text-align:center; margin-top:18px; color:#4d6a7a; font-size:0.9rem;">
                Already have an account?
                <a href="javascript:void(0)" onclick="switchToLogin()" style="color:#1e7b85; font-weight:600; text-decoration:none;">
                    Sign in
                </a>
            </p>
        </div>
    </div>

    <!-- Footer -->
    <footer class="container">
        <span><i class="far fa-copyright"></i> 2026 PropertyLeasing</span>
        <span>
            <i class="fas fa-phone-alt"></i> +63 2 8123 4567 &nbsp;|&nbsp; <a href="mailto:Gerald21Nacion@gmail.com"><i class="fas fa-envelope"></i> inquire@PropertyLeasing.ph</a>
        </span>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 🔑 CUSTOM SITE JS — CONTAINS MODAL + AJAX FUNCTIONS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @Html.AntiForgeryToken()
</body>
</html>