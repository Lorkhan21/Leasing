@using Microsoft.AspNetCore.Identity
@using Leasing.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    // 1. Fetch the current user from the database
    var currentUser = await UserManager.GetUserAsync(User);

    // 2. Use FullName if it exists, otherwise fall back to Email/Username
    var displayName = !string.IsNullOrEmpty(currentUser?.FullName)
        ? currentUser.FullName
        : (currentUser?.Email ?? User.Identity?.Name);

    <a href="/Identity/Account/Manage" style="color:#0b2a3c; font-weight:500; text-decoration:none; display:flex; align-items:center; gap:6px; cursor:pointer;" title="Manage your account">
        <i class="fas fa-user-circle" style="color:#1e7b85;"></i>
        @displayName
    </a>

    @if (User.IsInRole("Admin"))
    {
        <a href="@Url.Action("Index", "Admin")" style="color:#1e7b85; text-decoration:none; font-weight:500;">
            <i class="fas fa-cog"></i> Admin
        </a>
        <a href="@Url.Action("Index", "UserManagement")" style="color:#1e7b85; text-decoration:none; font-weight:500;">
            <i class="fas fa-users"></i> Users
        </a>
    }

    <form method="post" action="/Identity/Account/Logout" style="display:inline; margin:0;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="/" />
        <button type="submit" class="btn-outline" style="background:transparent; cursor:pointer;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </button>
    </form>
}
else
{
    <button type="button" class="btn-outline" onclick="openLoginModal()" style="background:transparent; cursor:pointer;">
        <i class="fas fa-user"></i> Sign in
    </button>
}