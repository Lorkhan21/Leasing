@using Microsoft.AspNetCore.Identity
@using Leasing.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrEmpty(currentUser?.FullName)
        ? currentUser.FullName
        : (currentUser?.Email ?? User.Identity?.Name);

    <!-- Logged-in user dropdown -->
    <div class="user-dropdown-wrap">
        <button type="button" class="user-dropdown-btn" onclick="toggleUserDropdown(event)">
            <i class="fas fa-user-circle"></i>
        </button>

        <div class="user-dropdown-menu" id="userDropdownMenu">
            <!-- Header -->
            <div class="user-dropdown-header">
                <i class="fas fa-user-circle" style="font-size: 2rem; color: #1e7b85;"></i>
                <div>
                    <div class="user-dropdown-name">@displayName</div>
                    <div class="user-dropdown-email">@currentUser?.Email</div>
                </div>
            </div>

            <div class="user-dropdown-divider"></div>

            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Index", "Admin")" class="user-dropdown-item">
                    <i class="fas fa-cog"></i> Admin
                </a>
                <a href="@Url.Action("Index", "UserManagement")" class="user-dropdown-item">
                    <i class="fas fa-users"></i> Users
                </a>
                <div class="user-dropdown-divider"></div>
            }

            <button type="button" class="user-dropdown-item" onclick="openChangePasswordModal(); toggleUserDropdown(event);">
                <i class="fas fa-key"></i> Change Password
            </button>

            <div class="user-dropdown-divider"></div>

            <form method="post" action="/Identity/Account/Logout" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="/" />
                <button type="submit" class="user-dropdown-item user-dropdown-logout">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </form>
        </div>
    </div>
}
else
{
    <!-- Logged-out: only Sign In -->
    <div class="user-dropdown-wrap">
        <button type="button" class="user-dropdown-btn" onclick="openLoginModal()" title="Sign in">
            <i class="fas fa-user-circle"></i>
        </button>
    </div>
}