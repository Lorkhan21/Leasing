@model List<Property>
@{
    ViewData["Title"] = $"{ViewBag.PageTitle} - RichPaulLeasing";
    string currentType = ViewBag.Type as string ?? "";
    string currentCity = ViewBag.City as string ?? "";
    string currentStatus = ViewBag.Status as string ?? "";
}

<!-- Back to Home -->
<a href="@Url.Action("Index", "Home")" class="back-to-main">
    <i class="fas fa-arrow-left"></i> Back to Home
</a>

<!-- Page Title -->
<div class="page-title-wrap">
    <div class="page-title">
        <h1>@ViewBag.PageTitle</h1>
        <p style="color:#4d6a7a; margin-top:6px;">
            @ViewBag.Count @(ViewBag.Count == 1 ? "property" : "properties") found
        </p>
    </div>
</div>

<!-- Filter Bar -->
<div style="background:white; padding:20px; border-radius:12px; border:1px solid #e9f0f2; margin-bottom:24px;">
    <form method="get" action="@Url.Action("Index")" style="display:flex; flex-wrap:wrap; gap:12px; align-items:end;">
        <div style="flex:1; min-width:150px;">
            <label style="display:block; font-weight:500; font-size:0.9rem; margin-bottom:6px;">Property Type</label>
            <select name="type" style="width:100%; padding:10px 12px; border:1px solid #dce0e0; border-radius:8px; background:white;">
                <option value="">All Types</option>
                <option value="Apartment" selected="@(currentType == "Apartment")">Apartment</option>
                <option value="Condo" selected="@(currentType == "Condo")">Condo</option>
                <option value="Warehouse" selected="@(currentType == "Warehouse")">Warehouse</option>
                <option value="Commercial" selected="@(currentType == "Commercial")">Commercial</option>
                <option value="Office" selected="@(currentType == "Office")">Office</option>
                <option value="House" selected="@(currentType == "House")">House</option>
                <option value="Lot" selected="@(currentType == "Lot")">Lot</option>
            </select>
        </div>

        <div style="flex:1; min-width:150px;">
            <label style="display:block; font-weight:500; font-size:0.9rem; margin-bottom:6px;">City</label>
            <input type="text" name="city" value="@currentCity" placeholder="Any city"
                   style="width:100%; padding:10px 12px; border:1px solid #dce0e0; border-radius:8px;" />
        </div>

        <div style="flex:1; min-width:150px;">
            <label style="display:block; font-weight:500; font-size:0.9rem; margin-bottom:6px;">Status</label>
            <select name="status" style="width:100%; padding:10px 12px; border:1px solid #dce0e0; border-radius:8px; background:white;">
                <option value="">Any Status</option>
                <option value="For Rent" selected="@(currentStatus == "For Rent")">For Rent</option>
                <option value="Leased" selected="@(currentStatus == "Leased")">Leased</option>
                <option value="For Sale" selected="@(currentStatus == "For Sale")">For Sale</option>
            </select>
        </div>

        <div>
            <button type="submit" style="padding:11px 24px; background:#1e7b85; color:white; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                <i class="fas fa-filter"></i> Filter
            </button>
            <a href="@Url.Action("Index")" style="margin-left:8px; padding:11px 20px; background:#e9ecef; color:#333; border-radius:8px; text-decoration:none; font-weight:500;">
                Clear
            </a>
        </div>
    </form>
</div>

<!-- Property Grid -->
@if (!Model.Any())
{
    <div style="background:white; padding:60px 20px; border-radius:16px; border:1px solid #e9f0f2; text-align:center;">
        <i class="fas fa-search" style="font-size:4rem; color:#cbd5db;"></i>
        <h3 style="margin-top:20px; color:#0b2a3c;">No properties found</h3>
        <p style="color:#4d6a7a;">Try changing your filters or <a href="@Url.Action("Index")" style="color:#1e7b85;">clear all filters</a>.</p>
    </div>
}
else
{
    <div class="property-grid">
        @foreach (var property in Model)
        {
            <div class="property-card">
                <div class="property-image-container">
                    @if (!string.IsNullOrEmpty(property.ImageUrl))
                    {
                        <img src="@property.ImageUrl" alt="@property.Title" class="property-image" />
                    }
                    else
                    {
                        <div class="property-image-placeholder"><i class="fas fa-image"></i></div>
                    }
                </div>

                <div class="property-header">
                    @if (property.IsFeatured)
                    {
                        <span class="property-tag featured">Featured</span>
                    }
                    <span class="property-tag @(property.Status == "Leased" ? "leased" : "")">@property.Status</span>
                </div>

                <div class="property-price">@property.Price <small>@property.PriceSuffix</small></div>
                <div class="property-title">@property.Title</div>
                <div class="property-address">
                    <i class="fas fa-map-marker-alt"></i> @property.Address
                </div>
                <div class="property-meta">
                    @foreach (var feature in property.Features)
                    {
                        <span><i class="fas @feature.Icon"></i> @feature.Value</span>
                    }
                    <span><i class="fas fa-building"></i> @property.PropertyType</span>
                </div>

                <div class="property-footer">
                    <div class="author">
                        <img src="@property.AgentImage" alt="@property.AgentName" />
                        <a href="#">@property.AgentName</a>
                    </div>
                    <span><i class="far fa-clock"></i> @GetTimeAgo(property.PostedDate)</span>
                </div>

                <a href="@Url.Action("Details", "Property", new { id = property.Id })"
                   style="display:block; margin-top:15px; padding:10px 20px; background:#1e7b85; color:white; border-radius:30px; text-decoration:none; font-weight:500; text-align:center;">
                    <i class="fas fa-envelope"></i> Inquire Now
                </a>
            </div>
        }
    </div>
}

@functions {
    string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.Days > 30) return $"{diff.Days / 30} months ago";
        if (diff.Days > 0) return $"{diff.Days} days ago";
        if (diff.Hours > 0) return $"{diff.Hours} hours ago";
        return "Just now";
    }
}