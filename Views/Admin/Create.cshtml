@model Property
@{
    ViewData["Title"] = "Add New Property";
}

<div style="max-width:900px; margin:20px auto;">
    <a href="@Url.Action("Index")" style="color:#1e7b85; text-decoration:none; font-weight:500;">
        <i class="fas fa-arrow-left"></i> Back to Properties
    </a>

    <h1 style="margin:20px 0 30px;">
        <i class="fas fa-plus-circle" style="color:#1e7b85;"></i> Add New Property
    </h1>

    <form method="post" enctype="multipart/form-data" style="background:white; padding:30px; border-radius:16px; border:1px solid #e9f0f2;">
        @Html.AntiForgeryToken()

        <!-- Title -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Title *</label>
            <input asp-for="Title" required
                   style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                   placeholder="e.g., Galino Apartment" />
            <span asp-validation-for="Title" style="color:#d9201b; font-size:0.85rem;"></span>
        </div>

        <!-- Price + Suffix -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Price *</label>
                <input asp-for="Price" required
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                       placeholder="e.g., ₱14,000" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Price Suffix (optional)</label>
                <input asp-for="PriceSuffix"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                       placeholder="e.g., – ₱22,000/mo" />
            </div>
        </div>

        <!-- Address -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Address *</label>
            <input asp-for="Address" required
                   style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                   placeholder="e.g., Galino IV, Grace Park East, Caloocan" />
        </div>

        <!-- City + Type -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">City *</label>
                <input asp-for="City" required
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                       placeholder="e.g., Caloocan" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Property Type</label>
                <select asp-for="PropertyType"
                        style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem; background:white;">
                    <option value="">-- Select Type --</option>
                    <option value="Residential">Residential</option>
                    <option value="Commercial">Commercial</option>
                    <option value="Warehouse">Warehouse</option>
                    <option value="Lot">Lot</option>
                </select>
            </div>
        </div>

        <!-- Status + Featured -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Status</label>
                <select asp-for="Status"
                        style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem; background:white;">
                    <option value="For Rent">For Rent</option>
                    <option value="Leased">Leased</option>
                    <option value="For Sale">For Sale</option>
                </select>
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Featured?</label>
                <div style="padding:12px; background:#f8fafc; border-radius:8px;">
                    <input asp-for="IsFeatured" type="checkbox" style="transform:scale(1.5); margin-right:8px;" />
                    <span style="color:#4d6a7a;">Show on home page carousel</span>
                </div>
            </div>
        </div>

        <!-- Agent Info -->
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Agent Name</label>
                <input asp-for="AgentName"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                       placeholder="e.g., Gerald Nacion" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Agent Email</label>
                <input asp-for="AgentEmail" type="email"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                       placeholder="e.g., agent@example.com" />
            </div>
        </div>

        <!-- Agent Image -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Agent Image (path or leave blank)</label>
            <input asp-for="AgentImage"
                   style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem;"
                   placeholder="e.g., /image/agent-1.jpg" />
        </div>

        <!-- NEW: Overview fields -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Bedrooms</label>
                <input asp-for="Bedrooms" type="number" min="0"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Bathrooms</label>
                <input asp-for="Bathrooms" type="number" min="0"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Area Size</label>
                <input asp-for="AreaSize" placeholder="e.g. 336 sqm"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
        </div>

        <!-- NEW: Address extras -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">State / County</label>
                <input asp-for="StateCounty"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Zip / Postal Code</label>
                <input asp-for="ZipCode"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Country</label>
                <input asp-for="Country"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
        </div>

        <!-- NEW: Description -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Description</label>
            <textarea asp-for="Description" rows="5"
                      placeholder="Detailed description of the property..."
                      style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem; resize:vertical;"></textarea>
        </div>

        <!-- NEW: Highlights -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Warehouse Highlights</label>
            <textarea asp-for="WarehouseHighlights" rows="3"
                      placeholder="e.g. Suitable for manufacturing, logistics..."
                      style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px; font-size:1rem; resize:vertical;"></textarea>
        </div>

        <!-- NEW: Rate, Terms, Lease -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:20px;">
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Rate</label>
                <input asp-for="RateDetails" placeholder="e.g. PHP 100,000 plus VAT"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Terms</label>
                <input asp-for="Terms" placeholder="e.g. 3 Months Deposit, 3 Months Advance"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
            <div>
                <label style="display:block; font-weight:500; margin-bottom:6px;">Lease Term</label>
                <input asp-for="LeaseTerm" placeholder="e.g. Minimum 3 years"
                       style="width:100%; padding:12px; border:1px solid #dce0e0; border-radius:8px;" />
            </div>
        </div>

        <!-- Property Image Upload -->
        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:500; margin-bottom:6px;">Property Image</label>
            <input type="file" name="imageFile" accept="image/*"
                   style="width:100%; padding:12px; border:1px dashed #1e7b85; border-radius:8px; background:#f8fafc;" />
            <small style="color:#4d6a7a;">Upload a JPG, PNG, or WebP file. It will be saved automatically.</small>
        </div>

        <!-- Buttons -->
        <div style="display:flex; gap:12px; margin-top:30px;">
            <button type="submit" style="padding:14px 32px; background:#1e7b85; color:white; border:none; border-radius:8px; font-weight:600; font-size:1rem; cursor:pointer;">
                <i class="fas fa-save"></i> Save Property
            </button>
            <a href="@Url.Action("Index")" style="padding:14px 32px; background:#e9ecef; color:#333; border-radius:8px; text-decoration:none; font-weight:600;">
                Cancel
            </a>
        </div>
    </form>
</div>