@model List<Property>
@{
    ViewData["Title"] = "Admin - Manage Properties";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin:20px 0 30px;">
    <h1 style="margin:0;">
        <i class="fas fa-cog" style="color:#1e7b85;"></i> Manage Properties
    </h1>
    <a href="@Url.Action("Create")" style="padding:12px 24px; background:#1e7b85; color:white; border-radius:8px; text-decoration:none; font-weight:600;">
        <i class="fas fa-plus"></i> Add New Property
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:15px 20px; background:#d4edda; border-radius:8px; color:#155724; margin-bottom:20px; border:1px solid #c3e6cb;">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

<div style="background:white; border-radius:12px; overflow:hidden; border:1px solid #e9f0f2;">
    <table style="width:100%; border-collapse:collapse;">
        <thead style="background:#0b2a3c; color:white;">
            <tr>
                <th style="padding:14px; text-align:left; font-weight:600;">Image</th>
                <th style="padding:14px; text-align:left; font-weight:600;">Title</th>
                <th style="padding:14px; text-align:left; font-weight:600;">City</th>
                <th style="padding:14px; text-align:left; font-weight:600;">Price</th>
                <th style="padding:14px; text-align:center; font-weight:600;">Featured</th>
                <th style="padding:14px; text-align:center; font-weight:600;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" style="padding:40px; text-align:center; color:#4d6a7a;">
                        <i class="fas fa-inbox" style="font-size:3rem; color:#ccc;"></i>
                        <p style="margin-top:10px;">No properties yet. Click "Add New Property" to get started.</p>
                    </td>
                </tr>
            }
            @foreach (var property in Model)
            {
                <tr style="border-bottom:1px solid #e9f0f2;">
                    <td style="padding:14px;">
                        @if (!string.IsNullOrEmpty(property.ImageUrl))
                        {
                            <img src="@property.ImageUrl" style="width:70px; height:50px; object-fit:cover; border-radius:6px;" />
                        }
                        else
                        {
                            <div style="width:70px; height:50px; background:#e9ecef; border-radius:6px; display:flex; align-items:center; justify-content:center;">
                                <i class="fas fa-image" style="color:#999;"></i>
                            </div>
                        }
                    </td>
                    <td style="padding:14px; font-weight:500;">@property.Title</td>
                    <td style="padding:14px;">@property.City</td>
                    <td style="padding:14px;">@property.Price @property.PriceSuffix</td>
                    <td style="padding:14px; text-align:center;">
                        @if (property.IsFeatured)
                        {
                            <span style="color:#28a745; font-size:1.2rem;">✓</span>
                        }
                        else
                        {
                            <span style="color:#ccc;">—</span>
                        }
                    </td>
                    <td style="padding:14px; text-align:center; white-space:nowrap;">
                        <a href="@Url.Action("Edit", new { id = property.Id })" style="color:#1e7b85; text-decoration:none; margin-right:12px; font-weight:500;">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form method="post" action="@Url.Action("Delete", new { id = property.Id })" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this property?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="background:none; border:none; color:#d9201b; cursor:pointer; font-weight:500; font-family:inherit; font-size:inherit; padding:0;">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>